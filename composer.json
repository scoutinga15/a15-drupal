{
    "name": "droptica/droopler-project",
    "description": "Project template for Droopler with Composer",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "homepage": "https://www.droopler.com",
    "support": {
        "docs": "https://www.droopler.com/developers",
        "issues": "https://www.drupal.org/project/issues/droopler?categories=All"
    },
    "repositories": {
        "drupal": {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        "asset": {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    },
    "require": {
        "composer/installers": "^1.2",
        "cweagans/composer-patches": "^1.7",
        "droptica/droopler": "8.3.2.0-rc1",
        "drupal/config_ignore": "^2.3",
        "drupal/core-composer-scaffold": "~9.5.11",
        "drupal/core-recommended": "~9.5.11",
        "drupal/entity_usage": "^2.0@beta",
        "drupal/gin": "^3.0",
        "drupal/gin_login": "^1.0",
        "drupal/gin_toolbar": "^1.0@beta",
        "drupal/honeypot": "^2.0",
        "drupal/signaturefield": "^1.0",
        "drupal/swiftmailer": "^2.1",
        "drupal/symfony_mailer_lite": "^1.0.7",
        "drupal/tome": "^1.4",
        "drupal/webform": "^6.1",
        "drush/drush": "^11.0",
        "oomphinc/composer-installers-extender": "^2.0"
    },
    "require-dev": {
        "deployer/deployer": "*",
        "drupal/core-dev": "~9.5.11",
        "drupal/devel": "^4.0"
    },
    "provide": {
        "drupal/contact": "9.5.11"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "drupal/core-composer-scaffold": true,
            "oomphinc/composer-installers-extender": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        },
        "platform": {
            "php": "8.1"
        },
        "audit": {
            "block-insecure": false
        }
    },
    "extra": {
        "composer-exit-on-patch-failure": true,
        "patches-file": "composer.patches.json",
        "patchLevel": {
            "drupal/core": "-p2"
        },
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            }
        },
        "installer-types": [
            "bower-asset",
            "npm-asset"
        ],
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library",
                "type:git",
                "type:bower-asset",
                "type:npm-asset"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "web/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "web/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ]
        },
        "enable-patching": true,
        "patches-ignore": {
            "droptica/droopler": {
                "drupal/we_megamenu": [
                    "web/profiles/contrib/droopler/patches/we_megamenu_compatibility_php81.patch",
                    "https://www.drupal.org/files/issues/2022-08-12/we_megamenu-3296290-5.patch",
                    "https://www.drupal.org/files/issues/2022-02-24/we_megamenu_deprecated.patch"
                ]
            }
        }
    }
}
