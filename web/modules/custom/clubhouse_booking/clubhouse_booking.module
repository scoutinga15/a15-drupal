<?php

/**
 * @file
 * Primary module hooks for Clubhouse Booking module.
 */

/**
 * Implements hook_theme().
 */
function clubhouse_booking_theme($existing, $type, $theme, $path) {
  return [
    'clubhouse_booking_calendar' => [
      'variables' => [],
    ],
    'paragraph__clubhouse_booking' => [
      'base hook' => 'paragraph',
    ],
    'paragraph__clubhouse_booking_free_slot_list' => [
      'base hook' => 'paragraph',
    ],
  ];
}

/**
 * Implements hook_preprocess_paragraph().
 */
function clubhouse_booking_preprocess_paragraph(&$variables) {
  /** @var \Drupal\paragraphs\Entity\Paragraph $paragraph */
  $paragraph = $variables['paragraph'];
  if ($paragraph->getType() === 'clubhouse_booking') {
    $variables['#attached']['library'][] = 'clubhouse_booking/booking_calendar';
    $variables['#attached']['drupalSettings']['clubhouseBooking']['language'] = \Drupal::languageManager()->getCurrentLanguage()->getId();
  }
  elseif ($paragraph->getType() === 'clubhouse_booking_free_slot_list') {
    $block_manager = \Drupal::service('plugin.manager.block');
    $block = $block_manager->createInstance('clubhouse_booking_free_slot_list_block', []);
    $variables['content']['free_slot_list'] = $block->build();
  }
}

/**
 * Implements hook_mail().
 */
function clubhouse_booking_mail($key, &$message, $params) {
  $options = [
    'langcode' => $message['langcode'],
  ];

  switch ($key) {
    case 'booking_confirmation':
      $message['from'] = \Drupal::config('system.site')->get('mail');
      $message['subject'] = t('Booking Confirmation: Clubhouse');
      $message['body'][] = t('Hello @name,', ['@name' => $params['user_name']], $options);
      $message['body'][] = t('Your booking for the clubhouse on @date has been confirmed.', [
        '@date' => $params['date'],
      ], $options);
      $message['body'][] = t('You can cancel your booking using the following link: @url', [
        '@url' => $params['cancel_url'],
      ], $options);
      break;

    case 'admin_booking_notification':
      $message['from'] = \Drupal::config('system.site')->get('mail');
      $message['subject'] = t('New Booking: Clubhouse');
      $message['body'][] = t('A new booking has been made by @name.', [
        '@name' => $params['user_name'],
      ], $options);
      $message['body'][] = t('Booked date: @date', [
        '@date' => $params['date'],
      ], $options);
      break;

    case 'booking_cancellation':
      $message['from'] = \Drupal::config('system.site')->get('mail');
      $message['subject'] = t('Booking Cancellation: Clubhouse');
      $message['body'][] = t('Hello @name,', ['@name' => $params['user_name']], $options);
      $message['body'][] = t('Your booking for the clubhouse on @date has been cancelled.', [
        '@date' => $params['date'],
      ], $options);
      break;

    case 'admin_cancellation_notification':
      $message['from'] = \Drupal::config('system.site')->get('mail');
      $message['subject'] = t('Booking Cancellation: Clubhouse');
      $message['body'][] = t('The booking for @date by @name has been cancelled.', [
        '@name' => $params['user_name'],
        '@date' => $params['date'],
      ], $options);
      break;

    case 'custom_slot_request':
      $message['from'] = \Drupal::config('system.site')->get('mail');
      $message['subject'] = t('New Date Request');
      $message['body'][] = t('A new date request has been submitted by @name (@email).', [
        '@name' => $params['user_name'],
        '@email' => $params['user_email'],
      ], $options);
      $message['body'][] = t('Requested date: @date', [
        '@date' => $params['date'],
      ], $options);
      $message['body'][] = t('Message: @message', ['@message' => $params['message']], $options);
      break;
  }
}
