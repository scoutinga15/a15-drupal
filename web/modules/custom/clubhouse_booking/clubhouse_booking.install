<?php

/**
 * @file
 * Install, update and uninstall functions for the clubhouse_booking module.
 */

/**
 * Implements hook_schema().
 */
function clubhouse_booking_schema() {
  $schema['clubhouse_slots'] = [
    'description' => 'Stores slots for the clubhouse.',
    'fields' => [
      'id' => [
        'description' => 'The primary identifier for a slot.',
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'booking_date' => [
        'description' => 'The date of the slot (YYYY-MM-DD).',
        'type' => 'varchar',
        'length' => 10,
        'not null' => TRUE,
      ],
      'to_date' => [
        'description' => 'The end date of the slot/booking (YYYY-MM-DD).',
        'type' => 'varchar',
        'length' => 10,
        'not null' => FALSE,
      ],
      'booking_id' => [
        'description' => 'The unique identifier for a booking group.',
        'type' => 'varchar',
        'length' => 128,
        'not null' => FALSE,
      ],
      'status' => [
        'description' => 'The status of the slot (free, requested, reserved, booked).',
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
        'default' => 'free',
      ],
      'user_name' => [
        'description' => 'Name of the person booking (if any).',
        'type' => 'varchar',
        'length' => 255,
        'not null' => FALSE,
      ],
      'user_email' => [
        'description' => 'Email of the person booking (if any).',
        'type' => 'varchar',
        'length' => 255,
        'not null' => FALSE,
      ],
      'message' => [
        'description' => 'Message for custom slot requests.',
        'type' => 'text',
        'not null' => FALSE,
      ],
      'created' => [
        'description' => 'Timestamp when the slot/booking was created.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'booking_date' => ['booking_date'],
    ],
  ];

  return $schema;
}

/**
 * Update schema to use day-based slots and include status, user info, and message.
 */
function clubhouse_booking_update_8001() {
  $database = \Drupal::database();
  $schema = $database->schema();

  if ($schema->tableExists('clubhouse_bookings')) {
    $schema->dropTable('clubhouse_bookings');
  }

  if ($schema->tableExists('clubhouse_slots')) {
    $schema->dropTable('clubhouse_slots');
  }

  $new_schema = clubhouse_booking_schema();
  $schema->createTable('clubhouse_slots', $new_schema['clubhouse_slots']);
}

/**
 * Add to_date and booking_id fields to clubhouse_slots.
 */
function clubhouse_booking_update_8002() {
  $database = \Drupal::database();
  $schema = $database->schema();

  if ($schema->tableExists('clubhouse_slots')) {
    if (!$schema->fieldExists('clubhouse_slots', 'to_date')) {
      $schema->addField('clubhouse_slots', 'to_date', [
        'description' => 'The end date of the slot/booking (YYYY-MM-DD).',
        'type' => 'varchar',
        'length' => 10,
        'not null' => FALSE,
      ]);
    }
    if (!$schema->fieldExists('clubhouse_slots', 'booking_id')) {
      $schema->addField('clubhouse_slots', 'booking_id', [
        'description' => 'The unique identifier for a booking group.',
        'type' => 'varchar',
        'length' => 128,
        'not null' => FALSE,
      ]);
    }
  }
}
